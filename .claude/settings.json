{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/require-spec-read.sh",
            "timeout": 10,
            "statusMessage": "Checking spec read status..."
          }
        ]
      }
    ]
  }
}
