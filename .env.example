# Copy to .env and fill in. Never commit .env.

# Shared password that unlocks the site (ADR 002, 006). Required: if empty,
# nobody can log in. Changing it logs every device out.
SITE_PASSWORD=

# Postgres connection string (ADR 004, 008), used by the app, the daily job and
# `npm run db:*`. For Neon use the pooled string; for dev use a separate branch.
DATABASE_URL=

# Demo season (ADR 021), read at build time. Defaults to 1 while the demo is
# in the code; set 0 to run the real app against DATABASE_URL.
# STOCK_LEAGUE_DEMO=0
