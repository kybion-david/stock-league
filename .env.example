# Copy to .env and fill in. Never commit .env.

# Shared password needed to make changes; viewing is public (ADR 002, 006, 028).
# Required: if empty, nobody can log in to edit. Changing it logs every device out.
SITE_PASSWORD=

# Postgres connection string (ADR 004, 008), used by the app, the daily job and
# `npm run db:*`. For Neon use the pooled string; for dev use a separate branch.
DATABASE_URL=
